# Placeholders only. Copy to .env (never committed) and fill in.
# The running backend connects as player_app (ADR 0002, section 9).
PLAYER_DATABASE_URL=postgresql://player_app:<password>@127.0.0.1:5432/classbeat_player
PLAYER_LOG_LEVEL=INFO
# The site's origin (ADR 0002, sections 4 and 5): what `Origin` must equal, and the start of
# the link in a sign-in mail. HTTPS, no path.
PLAYER_SITE_ORIGIN=https://<site host>
# Reverse proxies whose X-Forwarded-For is believed (addresses or networks, commas). Empty:
# the peer's own address is the client.
PLAYER_TRUSTED_PROXIES=
# Sources that may be linked (ADR 0002, section 7): a JSON list of
# {"id": "classbeat", "name": "classbeat", "redirect_uris": ["https://<source host>/<path>"]}.
# Empty: no source can be linked.
PLAYER_SOURCES=
# Mail (README, "Mail"). Without PLAYER_SMTP_HOST no mail is sent (NoMailer); the mail service
# is the owner's choice. TLS always: implicit (port 465) or starttls (587). The password is read
# only from the file named here (a secret mount), never from a variable.
# PLAYER_SMTP_HOST=<smtp host>
# PLAYER_SMTP_PORT=465
# PLAYER_SMTP_TLS=implicit
# PLAYER_SMTP_FROM=<sender address>
# PLAYER_SMTP_USER=<smtp user>
# PLAYER_SMTP_PASSWORD_FILE=/run/secrets/<smtp password file>
# PLAYER_SMTP_HELO_NAME=localhost
# Migrations and the operator's commands (`python -m player_backend.admin ...`), as player_owner.
PLAYER_DATABASE_OWNER_URL=postgresql://player_owner:<password>@127.0.0.1:5432/classbeat_player
# Tests only: superuser URL of a throwaway PostgreSQL 17 (README, "Tests").
PLAYER_TEST_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:55432/postgres
