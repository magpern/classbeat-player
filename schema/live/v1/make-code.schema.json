{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classbeat.example/schema/live/v1/make-code.schema.json",
  "title": "MakeCode",
  "description": "Host to server: make a new control code (it replaces the current one).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "The live contract's version."
    },
    "type": {
      "type": "string",
      "const": "make_code"
    }
  }
}
