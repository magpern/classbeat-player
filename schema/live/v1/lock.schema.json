{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classbeat.example/schema/live/v1/lock.schema.json",
  "title": "Lock",
  "description": "Host to server: lock (true) or unlock (false) the session for new riders (ADR 0007 section 3). While it is locked every join is answered cannot_join; riders already in stay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "locked"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "The live contract's version."
    },
    "type": {
      "type": "string",
      "const": "lock"
    },
    "locked": {
      "type": "boolean"
    }
  }
}
