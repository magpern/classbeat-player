{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classbeat.example/schema/live/v1/command-forwarded.schema.json",
  "title": "ForwardedCommand",
  "description": "Server to host: a controller's command with the slot the server stamped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "slot",
    "id",
    "run",
    "basis",
    "action"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "The live contract's version."
    },
    "type": {
      "type": "string",
      "const": "command"
    },
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "The controller's place, 1 or 2, given by the server."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "maxLength": 22,
      "description": "The command's id: 16 random bytes, base64url without padding, new for each tap."
    },
    "run": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "maxLength": 22,
      "description": "The class run's id: 16 random bytes, base64url without padding, new for each class run."
    },
    "basis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The seq of the companion_state the phone showed."
    },
    "action": {
      "type": "string",
      "enum": [
        "start",
        "pause",
        "resume",
        "skip",
        "nudge",
        "undo_resync"
      ],
      "description": "Exactly one of the companion's actions (ADR 0005 section 4)."
    },
    "deltaMs": {
      "type": "integer",
      "enum": [
        5000,
        -5000
      ],
      "description": "Only with nudge: exactly +5000 or -5000 ms (the presenter's JUMP_MS)."
    }
  },
  "if": {
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "const": "nudge"
      }
    }
  },
  "then": {
    "required": [
      "deltaMs"
    ]
  },
  "else": {
    "not": {
      "required": [
        "deltaMs"
      ]
    }
  }
}
