{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classbeat.example/schema/live/v1/host-status.schema.json",
  "title": "HostStatus",
  "description": "Server to controllers: whether the host is connected. While it is not, a controller sees this and nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "connected"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "The live contract's version."
    },
    "type": {
      "type": "string",
      "const": "host_status"
    },
    "connected": {
      "type": "boolean"
    }
  }
}
