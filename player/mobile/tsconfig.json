{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // The room screen's core (player/app) imports classformat; resolve it from this package.
    "paths": { "classformat/*": ["./node_modules/classformat/*"] }
  },
  "include": ["src", "test", "build.mjs", "build-config.mjs", "eslint.config.js"]
}
