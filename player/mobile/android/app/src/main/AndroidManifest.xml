<?xml version="1.0" encoding="utf-8"?>
<!-- The locked shell (issue #627). The page is bundled and served from the app's assets. The one
     permission asked for here is INTERNET, for the HTTPS calls to the backend origin fixed in the
     build (owner, 2026-11-26, #649): only backend/BackendTransport.kt opens a connection, and
     rules.test.ts holds every other file to that. ManifestTest checks the merged
     manifest against PermissionPolicy's allowlist. Backup and cleartext are off. The notification
     listener (issue #632) is not a permission the app asks for: only the system may bind it, and
     it is disabled until the instructor turns following on in instructor mode. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Empty: it reads no notification (FollowListener.kt). Only the system can bind it. -->
        <service
            android:name=".follow.FollowListener"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
