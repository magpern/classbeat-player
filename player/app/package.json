{
  "name": "classbeat-player-app",
  "version": "0.0.0",
  "private": true,
  "description": "The class player desktop application: Electron shell, class files and the class clock (issue #29).",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:e2e": "npm run build && node --import tsx --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "test": "bash ci.sh",
    "test:shots": "npm run build && node --import tsx --test --test-concurrency=1 \"test/shots/*.test.ts\""
  },
  "dependencies": {
    "classformat": "file:../../schema/ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "electron": "44.10.0",
    "esbuild": "0.28.1",
    "eslint": "10.13.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
