{
  "name": "music-follower-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Spike 1 (throwaway): follow the Spotify desktop app through the operating system and log how well a class clock tracks it.",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "music-follower": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
