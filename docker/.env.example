# Settings for docker/compose.backend.yml. Copy to docker/.env (never committed) and fill in.
# Placeholders only: no secret belongs in this file. Passwords are files, see PLAYER_SECRETS_DIR.

# --- Required ---------------------------------------------------------------------------------

# Directory that holds the secret files (one value per file, one line each): postgres_password,
# player_owner_password, player_app_password, player_smtp_password. Outside the repository, mode
# 0440 and group 10010. See the runbook, "Secrets".
PLAYER_SECRETS_DIR=/etc/classbeat-player/secrets

# The website's origin: what the browser's Origin header must equal, and the start of the link in
# a sign-in mail. HTTPS only, no path. The domain is the owner's.
PLAYER_SITE_ORIGIN=https://player.example.com

# The backend's address as the desktop app reaches it (HTTPS). NOT read by the backend: it is the
# app's setting (PLAYER_BACKEND_ORIGIN in the app's environment). Listed here so the site origin
# and the backend origin are set together; the compose file does not pass it on.
PLAYER_BACKEND_ORIGIN=https://player.example.com

# --- Proxy and sources ------------------------------------------------------------------------

# Addresses or networks, comma separated, whose X-Forwarded-For counts. Set it to the address the
# host's reverse proxy shows up as. The server's published port is reached through the `edge`
# network (PLAYER_EDGE_SUBNET, 10.213.80.0/24 by default), so a proxy on the same host appears as
# that network's gateway, 10.213.80.1. Empty means the header is never trusted and every client looks like the
# proxy (sign-in limits then count the whole world as one address).
PLAYER_TRUSTED_PROXIES=10.213.80.1

# The sources that may be linked, a JSON list of {"id", "name", "redirect_uris"} (ADR 0002,
# section 7). Empty means none: no source can be linked.
PLAYER_SOURCES=

# --- Optional ---------------------------------------------------------------------------------

# DEBUG, INFO, WARNING or ERROR.
PLAYER_LOG_LEVEL=INFO

# The server's own network range, outside Docker's default pools. Change it if it collides with
# a network on the host, and change PLAYER_TRUSTED_PROXIES to the new range's .1 with it.
PLAYER_EDGE_SUBNET=10.213.80.0/24

# Host port of the server, bound to 127.0.0.1 only. The reverse proxy forwards to it.
PLAYER_BACKEND_PORT=8000

# The database's name, and the image tag the compose file builds and runs.
PLAYER_DB_NAME=player
PLAYER_BACKEND_VERSION=local

# The minute of every hour at which the purge runs (0-59).
PLAYER_PURGE_MINUTE=17

# Mail. Leave all PLAYER_SMTP_ lines out (commented, as here) and every mail is dropped. The
# backend refuses any PLAYER_SMTP_ setting unless PLAYER_SMTP_HOST is set, so never give one an
# empty value. With a host: PLAYER_SMTP_FROM is needed; TLS is `implicit` (default) or `starttls`,
# there is no plain mode; PLAYER_SMTP_USER and PLAYER_SMTP_PASSWORD_FILE go together. The password
# is the file player_smtp_password in PLAYER_SECRETS_DIR, mounted at the path below.
# PLAYER_SMTP_HOST=smtp.example.com
# PLAYER_SMTP_FROM=login@player.example.com
# PLAYER_SMTP_TLS=implicit
# PLAYER_SMTP_PORT=465
# PLAYER_SMTP_USER=login@player.example.com
# PLAYER_SMTP_PASSWORD_FILE=/run/secrets/player_smtp_password
# PLAYER_SMTP_HELO_NAME=localhost
